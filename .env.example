# Optional. Without this, SQLite is created in the backend working directory.
# PostgreSQL example: postgresql+psycopg://scamshield:change-me@localhost:5432/scamshield
DATABASE_URL=sqlite:///./scamshield.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500
MAX_UPLOAD_MB=8
MIN_ANALYSIS_CHARACTERS=25
HIGH_RISK_THRESHOLD=65
MEDIUM_RISK_THRESHOLD=35
ML_MAX_CONTRIBUTION=15
